{
  "verbose": true,
  "moduleFileExtensions": ["js", "mjs"],
  "testRegex": ".*\\.test\\.mjs$",
  "transform": {
    "\\.mjs$": [
      "babel-jest",
      {
        "presets": [
          [
            "@babel/preset-env",
            {
              "targets": {
                "node": "current"
              }
            }
          ]
        ],
        "plugins": [
          "babel-plugin-transform-import-meta"
        ]
      }
    ]
  }
}
